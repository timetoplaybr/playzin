// Permite que o usuário "playzin" (que roda o daemon, sem sessão gráfica)
// monte pendrives via UDisks2 sem pedir senha. Nada além de montar/desmontar.
polkit.addRule(function (action, subject) {
  if (subject.user !== "playzin") return polkit.Result.NOT_HANDLED;
  var allowed = [
    "org.freedesktop.udisks2.filesystem-mount",
    "org.freedesktop.udisks2.filesystem-mount-other-seat",
    "org.freedesktop.udisks2.filesystem-unmount-others"
  ];
  if (allowed.indexOf(action.id) >= 0) return polkit.Result.YES;
  return polkit.Result.NOT_HANDLED;
});
